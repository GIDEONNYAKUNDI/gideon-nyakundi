# The site root only serves index.html; the back office starts at index.php.
DirectoryIndex index.php
Options -Indexes

# Only index.php is a page. config.php (the database password), the code libraries
# (_lib.php, _messaging.php, _settings.php, _tally.php, _tally_page.php) and config.sample.php can never be opened from a browser.
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Cache-Control "no-store"
</IfModule>
